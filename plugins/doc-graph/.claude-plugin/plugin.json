{
  "name": "doc-graph",
  "description": "Doc-Graph — Paperless-Dokumentgraph (stdio-Proxy, Token im OS-Keychain; ai-rem ≥ 1.12, vorher `ai-rem svc pair doc-graph`)",
  "version": "2.0.0",
  "author": {
    "name": "Markus"
  },
  "userConfig": {
    "url": {
      "type": "string",
      "title": "doc-graph URL",
      "description": "Basis-URL des doc-graph-Servers (https, ohne /mcp)",
      "default": "https://docgraph.lan"
    }
  },
  "mcpServers": {
    "doc-graph": {
      "command": "/bin/sh",
      "args": [
        "-c",
        "cd \"$HOME\" && exec \"$0\" \"$@\"",
        "ai-rem",
        "svc",
        "proxy",
        "doc-graph",
        "--url",
        "${user_config.url}"
      ]
    }
  }
}
