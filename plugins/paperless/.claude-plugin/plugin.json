{
  "name": "paperless",
  "description": "Paperless-ngx API (stdio, Secret über ai-rem run aus mykeyvault)",
  "version": "1.2.0",
  "author": {
    "name": "Markus"
  },
  "userConfig": {
    "dist": {
      "type": "string",
      "title": "index.js Pfad",
      "description": "Pfad zur gebauten paperless-mcp dist/index.js",
      "default": "/home/markus/mystorage/myCode/github/paperless-mcp/dist/index.js"
    },
    "url": {
      "type": "string",
      "title": "PAPERLESS_URL",
      "description": "z.B. https://paperless"
    }
  },
  "mcpServers": {
    "paperless": {
      "command": "/bin/sh",
      "args": [
        "-c",
        "cd \"$HOME\" && exec \"$0\" \"$@\"",
        "ai-rem",
        "run",
        "--secret",
        "paperless-token=PAPERLESS_TOKEN",
        "--",
        "node",
        "${user_config.dist}"
      ],
      "env": {
        "PAPERLESS_URL": "${user_config.url}"
      }
    }
  }
}
